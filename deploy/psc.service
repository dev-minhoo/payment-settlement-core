[Unit]
Description=payment-settlement-core
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=ec2-user
EnvironmentFile=/etc/psc/psc.env
ExecStart=/usr/bin/java -Xms256m -Xmx384m -jar /opt/psc/app.jar
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
